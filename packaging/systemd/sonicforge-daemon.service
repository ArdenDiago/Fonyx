[Unit]
Description=SonicForge per-application audio mixer daemon
After=pipewire.service pipewire-session-manager.service
Wants=pipewire.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# notify + watchdog: the daemon sends READY=1 once PipeWire is up and
# WATCHDOG=1 every 2s from its PipeWire thread. A hang (thread wedged but
# process alive) stops the pings, and systemd kills and restarts it just
# like a crash.
Type=notify
WatchdogSec=10
ExecStart=/usr/bin/sonicforge-daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
