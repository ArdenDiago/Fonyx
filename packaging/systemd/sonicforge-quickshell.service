[Unit]
Description=SonicForge Quickshell widget
After=graphical-session.target sonicforge-daemon.service
Wants=sonicforge-daemon.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/quickshell -p /usr/share/sonicforge/quickshell/SonicForgeApp.qml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
