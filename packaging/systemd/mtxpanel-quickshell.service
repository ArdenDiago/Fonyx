[Unit]
Description=MTX Panel Quickshell widget
After=graphical-session.target mtxpanel-daemon.service
Wants=mtxpanel-daemon.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/quickshell -p /usr/share/mtxpanel/quickshell/MtxPanelApp.qml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
